    "app/api/pfp/generate-cv/route.ts": { "maxDuration": 60 },
    "app/api/job/pfp-sweep/route.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/job/pfp-sweep", "schedule": "0 */3 * * *" },
    { "path": "/api/job/consult-timeout", "schedule": "0 * * * *" }
  ]
}
